# Copier ce fichier en .env (ignoré par Git) et renseigner les valeurs.
# En CI, ces variables sont fournies par les secrets GitHub.

# Clé de l'API INSEE (portail-api.insee.fr) — nécessaire à partir du lot 1 si l'accès BDM l'exige
INSEE_API_KEY=

# Clé de l'API Webstat de la Banque de France — lot 3
BDF_WEBSTAT_API_KEY=
