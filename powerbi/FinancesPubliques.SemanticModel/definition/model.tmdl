model Model
	culture: fr-FR
	discourageImplicitMeasures
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["ModeSource","DossierLocal","BrancheGitHub","fnLireParquet","Dim_Date","Dim_Sous_Secteur","Dim_Pays","Dim_Transaction","Dim_COFOG","Dim_Prelevement","Dim_Source","Dim_Millesime","Dim_Indicateur","Fait_Comptes_APU_Annuels","Fait_Depenses_Fonction","Fait_Prelevements","Fait_Macro_Annuel","Fait_Revisions","Dim_Fonction_Economique","Fait_Prelevements_Fonction","Dim_Sous_Secteur_Receveur","Fait_Transferts_APU","Pres_Flux_Sankey","Dim_Glossaire","Dim_Instrument_Dette","Dim_Detenteur","Fait_Dette","Fait_Dette_Instrument","Fait_Detention_Dette","Fait_Taux_Marche"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Date
ref table Dim_Sous_Secteur
ref table Dim_Pays
ref table Dim_Transaction
ref table Dim_COFOG
ref table Dim_Prelevement
ref table Dim_Source
ref table Dim_Millesime
ref table Dim_Indicateur
ref table Fait_Comptes_APU_Annuels
