model Model
	culture: fr-FR
	discourageImplicitMeasures
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["ModeSource","DossierLocal","BrancheGitHub","fnLireParquet","Dim_Date","Dim_Sous_Secteur","Dim_Pays","Dim_Transaction","Dim_COFOG","Dim_Prelevement","Dim_Source","Dim_Millesime","Dim_Indicateur","Fait_Comptes_APU_Annuels","Fait_Depenses_Fonction","Fait_Prelevements","Fait_Macro_Annuel","Fait_Revisions","Dim_Fonction_Economique","Fait_Prelevements_Fonction","Dim_Sous_Secteur_Receveur","Fait_Transferts_APU","Pres_Flux_Sankey","Dim_Glossaire","Dim_Instrument_Dette","Dim_Detenteur","Fait_Dette","Fait_Dette_Instrument","Fait_Detention_Dette","Fait_Taux_Marche","Fait_Dette_Trimestrielle","Fait_Macro_Trimestriel","Fait_Comptes_APU_Trimestriels","Dim_Agregat_Trimestriel","Fait_Dette_Contributions","Fait_Dette_Negociable_Etat","Dim_Composante_Dette_Etat","Fait_Courbe_Taux"]

annotation PBI_ProTooling = ["DevMode"]

