/// Mesures du modèle, rangées par dossier.
table _Mesures
	lineageTag: ef206ef6-c69e-4882-9f1a-936a0b2b7293

	/// Somme de Fait_Comptes_APU_Annuels pour un seul pays (vide si plusieurs pays : on n'additionne jamais des pays entre eux).
	measure 'Montant APU (M€)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Comptes_APU_Annuels[valeur_meur] ) )
		isHidden
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: f1a86a84-6690-42d0-a2ca-d156488e55b7

	/// Somme de Fait_Prelevements pour un seul pays.
	measure 'Prélèvements détaillés (M€)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Prelevements[valeur_meur] ) )
		isHidden
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 9320eda2-8d61-4d79-8e88-d06a6f150561

	/// Total des dépenses des administrations publiques (comptabilité nationale).
	measure 'Dépenses publiques (M€)' = CALCULATE ( [Montant APU (M€)], Dim_Transaction[Sens] = "Dépense" )
		formatString: #,0
		displayFolder: 02 Dépenses
		lineageTag: 56d67cab-37bc-4cec-b31d-80ef9a3b780b

	/// Dépenses ventilées par fonction COFOG (santé, éducation…) et nature.
	measure 'Dépenses par fonction (M€)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Depenses_Fonction[valeur_meur] ) )
		formatString: #,0
		displayFolder: 02 Dépenses
		lineageTag: d7fe01cd-238e-4a9b-8fad-57837d79f90a

	/// Part de la fonction dans la dépense publique, à périmètre (pays, année, sous-secteur, nature) inchangé.
	measure 'Part de la dépense (%)' =
			DIVIDE (
			    [Dépenses par fonction (M€)],
			    CALCULATE ( [Dépenses par fonction (M€)], REMOVEFILTERS ( Dim_COFOG ) )
			)
		formatString: 0.0 %
		displayFolder: 02 Dépenses
		lineageTag: 7bdb4937-61df-4064-80a7-776eb0756373

	/// Sur 1 000 € de dépense publique, montant consacré à la fonction.
	measure 'Pour 1 000 € de dépense publique' = [Part de la dépense (%)] * 1000
		formatString: #,0 €
		displayFolder: 02 Dépenses
		lineageTag: 49bdeefa-0eff-4c49-a4d5-e9646973f3a0

	/// Total des recettes des administrations publiques.
	measure 'Recettes publiques (M€)' = CALCULATE ( [Montant APU (M€)], Dim_Transaction[Sens] = "Recette" )
		formatString: #,0
		displayFolder: 01 Recettes
		lineageTag: c96ea915-f43d-4044-b0bc-3ce0b6efe641

	/// Impôts et cotisations sociales effectives, nets des montants non recouvrables (définition Eurostat).
	measure 'Prélèvements obligatoires (M€)' = CALCULATE ( [Prélèvements détaillés (M€)], Dim_Prelevement[Prélèvement obligatoire] = TRUE () )
		formatString: #,0
		displayFolder: 01 Recettes
		lineageTag: d6390b33-13d5-4c86-8928-16e1ccb9dcf5

	/// Tous les impôts et cotisations sociales, y compris les cotisations imputées.
	measure 'Prélèvements (M€)' = [Prélèvements détaillés (M€)]
		formatString: #,0
		displayFolder: 01 Recettes
		lineageTag: e00b0e60-018a-4121-a684-54b67f03a62d

	/// Prélèvements obligatoires rapportés au PIB.
	measure 'Taux de prélèvements obligatoires' = DIVIDE ( [Prélèvements obligatoires (M€)], [PIB (M€)] )
		formatString: 0.0 %
		displayFolder: 01 Recettes
		lineageTag: b2bf7cd3-2cc1-4864-94bb-c1c00ee6c77f

	/// Recettes − dépenses : négatif = déficit (besoin de financement).
	measure 'Solde public (M€)' = [Recettes publiques (M€)] - [Dépenses publiques (M€)]
		formatString: #,0
		displayFolder: 03 Solde
		lineageTag: 8298f7da-4d2a-4742-977f-3fdd74736b9a

	/// Intérêts versés sur la dette publique.
	measure 'Charge d''intérêts (M€)' = CALCULATE ( [Montant APU (M€)], Dim_Transaction[Code nature] = "D41_PAY" )
		formatString: #,0
		displayFolder: 03 Solde
		lineageTag: a55f158d-2275-4e95-bbb4-83a06ff1ba80

	/// Solde hors charge d'intérêts : l'équilibre des comptes hors coût de la dette passée.
	measure 'Solde primaire (M€)' = [Solde public (M€)] + [Charge d'intérêts (M€)]
		formatString: #,0
		displayFolder: 03 Solde
		lineageTag: a1ecea8f-0451-44de-a131-d6d94aa66e2c

	/// Solde public rapporté au PIB (la référence européenne est −3 %).
	measure 'Solde public (% PIB)' = DIVIDE ( [Solde public (M€)], [PIB (M€)] )
		formatString: 0.0 %
		displayFolder: 03 Solde
		lineageTag: ee75b578-c964-4230-869b-84d58b77894b

	/// Produit intérieur brut à prix courants.
	measure 'PIB (M€)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Macro_Annuel[pib_meur] ) )
		formatString: #,0
		displayFolder: 10 Contexte
		lineageTag: b26eebc9-e9f0-4851-9ea1-b28bbd52dd08

	/// Population moyenne de l'année (comptabilité nationale).
	measure 'Population' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Macro_Annuel[population] ) )
		formatString: #,0
		displayFolder: 10 Contexte
		lineageTag: 1f4fa5d8-d0d0-4104-9aa1-b3708115b4bf

	/// Croissance réelle du PIB (hors inflation) par rapport à l'année précédente.
	measure 'Croissance du PIB en volume (%)' =
			IF (
			    HASONEVALUE ( Dim_Date[Année] ),
			    DIVIDE ( SUM ( Fait_Macro_Annuel[croissance_volume_pct] ), 100 )
			)
		formatString: 0.0 %
		displayFolder: 10 Contexte
		lineageTag: ccd073a0-a09e-4bbd-89ba-1033c74bf537

	/// Valeur d'un agrégat telle que publiée dans le millésime sélectionné.
	measure 'Valeur publiée (M€)' =
			IF (
			    HASONEVALUE ( Dim_Millesime[Millésime] ),
			    SUM ( Fait_Revisions[valeur_meur] )
			)
		formatString: #,0
		displayFolder: 04 Révisions
		lineageTag: ab822327-0d76-4087-831b-ac21eab7ef3d

	/// Prélèvements répartis par base économique et par payeur (lecture légale ou économique).
	measure 'Prélèvements par payeur (M€)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Prelevements_Fonction[valeur_meur] ) )
		formatString: #,0
		displayFolder: 01 Recettes
		lineageTag: 770f6131-6e78-443d-b5e1-ac878d503a9b

	/// Part du payeur (ou de la base) dans les prélèvements, à périmètre inchangé.
	measure 'Part des prélèvements (%)' =
			DIVIDE (
			    [Prélèvements par payeur (M€)],
			    CALCULATE ( [Prélèvements par payeur (M€)], REMOVEFILTERS ( Dim_Fonction_Economique ) )
			)
		formatString: 0.0 %
		displayFolder: 01 Recettes
		lineageTag: ca5c7259-2ff9-4b14-9da6-5e3fc2c4c9b3

	/// Transferts versés d'une administration à une autre (dotations, aides à l'investissement, revenus de la propriété). Sous-secteur versant : Dim_Sous_Secteur ; receveur : Dim_Sous_Secteur_Receveur.
	measure 'Transferts entre administrations (M€)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), SUM ( Fait_Transferts_APU[valeur_meur] ) )
		formatString: #,0
		displayFolder: 05 Transferts
		lineageTag: 1089ba6a-aae6-4696-bcbb-4132c5f71b31

	/// Montant des flux du Sankey « où va l'argent ? » (Pres_Flux_Sankey). Choisir une seule lecture du payeur.
	measure 'Flux (M€)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ) && HASONEVALUE ( Pres_Flux_Sankey[Lecture du payeur] ),
			    SUM ( Pres_Flux_Sankey[valeur_meur] )
			)
		formatString: #,0
		displayFolder: 05 Transferts
		lineageTag: 5f4db9b7-b680-4192-8c4d-d8932ddee681

	/// Dépenses publiques en milliards d'euros.
	measure 'Dépenses publiques (Md€)' = DIVIDE ( [Dépenses publiques (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: 0082fb8a-c805-4c3f-8ea6-67e593309146

	/// Recettes publiques en milliards d'euros.
	measure 'Recettes publiques (Md€)' = DIVIDE ( [Recettes publiques (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: f3fc3991-2f5b-433d-8778-a66f4d825cf3

	/// Solde public en milliards d'euros (négatif = déficit).
	measure 'Solde public (Md€)' = DIVIDE ( [Solde public (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: c9c56ca0-30af-4410-953c-9560f94f329f

	/// Impôts et cotisations sociales, en milliards d'euros.
	measure 'Prélèvements obligatoires (Md€)' = DIVIDE ( [Prélèvements obligatoires (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: edb56885-1fe1-44cb-8f52-c2837f5a1c9f

	/// Intérêts de la dette, en milliards d'euros.
	measure 'Charge d''intérêts (Md€)' = DIVIDE ( [Charge d''intérêts (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: 0a0871c2-6906-42e8-bb2b-827f01a40030

	/// Dépenses par fonction, en milliards d'euros.
	measure 'Dépenses par fonction (Md€)' = DIVIDE ( [Dépenses par fonction (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: 7dc9b66f-4169-4dcf-abab-91f97fa37a8e

	/// Prélèvements par payeur, en milliards d'euros.
	measure 'Prélèvements par payeur (Md€)' = DIVIDE ( [Prélèvements par payeur (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: 7a5242b0-d0ff-446d-a7dc-7097b209bb5a

	/// Transferts entre administrations, en milliards d'euros.
	measure 'Transferts entre administrations (Md€)' = DIVIDE ( [Transferts entre administrations (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: 6eeec5bd-08ed-4bf9-b642-b427a93162bb

	/// Flux du diagramme « où va l'argent ? », en milliards d'euros.
	measure 'Flux (Md€)' = DIVIDE ( [Flux (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 20 Pédagogie
		lineageTag: 5569a6b8-27a4-4c29-9bc7-edacf6c2c756

	/// Dépenses publiques rapportées à la richesse produite (PIB).
	measure 'Dépenses publiques (% PIB)' = DIVIDE ( [Dépenses publiques (M€)], [PIB (M€)] )
		formatString: "0.0 %"
		displayFolder: 20 Pédagogie
		lineageTag: 1669c373-ba98-48f4-9d53-071e66f7e103

	/// Recettes publiques rapportées à la richesse produite (PIB).
	measure 'Recettes publiques (% PIB)' = DIVIDE ( [Recettes publiques (M€)], [PIB (M€)] )
		formatString: "0.0 %"
		displayFolder: 20 Pédagogie
		lineageTag: 2fde3ec4-a47d-4ebc-a13f-b4399d386142

	/// Dépenses publiques divisées par le nombre d'habitants.
	measure 'Dépenses publiques par habitant (€)' = DIVIDE ( [Dépenses publiques (M€)] * 1000000, [Population] )
		formatString: "#,0 ""€"""
		displayFolder: 20 Pédagogie
		lineageTag: fe6fce85-14f3-48ea-9d81-64b9d3a46b9c

	/// Impôts et cotisations sociales divisés par le nombre d'habitants.
	measure 'Prélèvements obligatoires par habitant (€)' = DIVIDE ( [Prélèvements obligatoires (M€)] * 1000000, [Population] )
		formatString: "#,0 ""€"""
		displayFolder: 20 Pédagogie
		lineageTag: 297e58d1-7433-4cf1-839c-c07c1edaa74c

	/// Pour 100 € de richesse produite dans le pays, montant de dépense publique.
	measure 'Sur 100 € de richesse produite' = [Dépenses publiques (% PIB)] * 100
		formatString: "#,0 ""€"""
		displayFolder: 20 Pédagogie
		lineageTag: e050af7e-2047-4278-8177-3c12979e1227

	/// Rappel du pays et de l'année affichés, ou invitation à les choisir.
	measure 'Titre de la sélection' =
			VAR _pays = SELECTEDVALUE ( Dim_Pays[Pays] )
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			RETURN
			    IF (
			        ISBLANK ( _pays ) || ISBLANK ( _annee ),
			        "Choisissez un pays et une année",
			        _pays & " — " & _annee
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 000fe2a8-003c-42ed-9a5b-c8e1178d0b12

	/// Les dépenses publiques de l'année, en une phrase.
	measure 'Phrase : combien ?' =
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _dep = [Dépenses publiques (Md€)]
			VAR _pour100 = [Sur 100 € de richesse produite]
			VAR _hab = [Dépenses publiques par habitant (€)]
			RETURN
			    IF (
			        ISBLANK ( _annee ) || ISBLANK ( _dep ),
			        "Choisissez un pays et une année pour afficher les chiffres.",
			        "En " & _annee & ", les administrations publiques ont dépensé "
			            & FORMAT ( _dep, "#,0", "fr-FR" ) & " milliards d'euros, soit "
			            & FORMAT ( _pour100, "0", "fr-FR" ) & " € pour 100 € de richesse produite dans le pays, ou "
			            & FORMAT ( _hab, "#,0", "fr-FR" ) & " € par habitant."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: d2d15f6f-0832-4b05-a2be-82f31b3c20bf

	/// Déficit ou excédent de l'année, en une phrase.
	measure 'Phrase : solde' =
			VAR _rec = [Recettes publiques (Md€)]
			VAR _solde = [Solde public (Md€)]
			VAR _pct = ABS ( [Solde public (% PIB)] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _solde ), "",
			        _solde < 0,
			            "Les recettes (" & FORMAT ( _rec, "#,0", "fr-FR" ) & " milliards d'euros) n'ont pas suffi : il a fallu emprunter "
			                & FORMAT ( -_solde, "#,0", "fr-FR" ) & " milliards d'euros. C'est le déficit public, égal à "
			                & FORMAT ( _pct, "0.0 %", "fr-FR" ) & " de la richesse produite.",
			        "Les recettes (" & FORMAT ( _rec, "#,0", "fr-FR" ) & " milliards d'euros) ont dépassé les dépenses : excédent de "
			            & FORMAT ( _solde, "#,0", "fr-FR" ) & " milliards d'euros, soit "
			            & FORMAT ( _pct, "0.0 %", "fr-FR" ) & " de la richesse produite."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: fed4e64e-132f-41c5-844a-faacbc4f7905

	/// Qui verse et qui supporte les prélèvements, en une phrase.
	measure 'Phrase : qui paie ?' =
			VAR _total = CALCULATE ( [Prélèvements par payeur (M€)], REMOVEFILTERS ( Dim_Fonction_Economique ) )
			VAR _menages_eco = CALCULATE ( [Prélèvements par payeur (M€)], REMOVEFILTERS ( Dim_Fonction_Economique ), Dim_Fonction_Economique[Groupe de payeurs (économique)] = "Ménages" )
			VAR _menages_leg = CALCULATE ( [Prélèvements par payeur (M€)], REMOVEFILTERS ( Dim_Fonction_Economique ), Dim_Fonction_Economique[Groupe de payeurs (légal)] = "Ménages" )
			VAR _ent_leg = CALCULATE ( [Prélèvements par payeur (M€)], REMOVEFILTERS ( Dim_Fonction_Economique ), Dim_Fonction_Economique[Groupe de payeurs (légal)] = "Entreprises" )
			RETURN
			    IF (
			        ISBLANK ( _total ),
			        "Choisissez un pays et une année pour afficher les chiffres.",
			        "Sur 100 € d'impôts et de cotisations, les entreprises en versent "
			            & FORMAT ( DIVIDE ( _ent_leg, _total ) * 100, "0", "fr-FR" ) & " € et les ménages "
			            & FORMAT ( DIVIDE ( _menages_leg, _total ) * 100, "0", "fr-FR" )
			            & " €. Mais une fois les coûts répercutés sur les prix et les salaires, les ménages en supportent environ "
			            & FORMAT ( DIVIDE ( _menages_eco, _total ) * 100, "0", "fr-FR" ) & " €."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 9432678f-5409-4fc4-86b2-b2b8a48686b7

	/// Les trois premiers postes de dépense, en une phrase.
	measure 'Phrase : où va l''argent ?' =
			VAR _top =
			    TOPN (
			        3,
			        FILTER ( VALUES ( Dim_COFOG[Fonction] ), NOT ISBLANK ( [Pour 1 000 € de dépense publique] ) ),
			        [Pour 1 000 € de dépense publique], DESC
			    )
			RETURN
			    IF (
			        ISEMPTY ( _top ),
			        "Choisissez un pays et une année pour afficher les chiffres.",
			        "Sur 1 000 € de dépense publique, les trois premiers postes sont : "
			            & CONCATENATEX (
			                _top,
			                Dim_COFOG[Fonction] & " (" & FORMAT ( [Pour 1 000 € de dépense publique], "#,0", "fr-FR" ) & " €)",
			                ", ",
			                [Pour 1 000 € de dépense publique], DESC
			            ) & "."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 756beaaa-0aa3-4a30-a4da-b5cc63f15732

	/// Classement du pays choisi parmi les pays comparés, en une phrase.
	measure 'Phrase : comparaison' =
			VAR _valeur = [Dépenses publiques (% PIB)]
			VAR _pays = SELECTEDVALUE ( Dim_Pays[Pays] )
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _rang =
			    CALCULATE (
			        RANKX (
			            FILTER (
			                ALL ( Dim_Pays[Code pays], Dim_Pays[Type de pays] ),
			                Dim_Pays[Type de pays] = "Pays" && NOT ISBLANK ( [Dépenses publiques (% PIB)] )
			            ),
			            [Dépenses publiques (% PIB)], _valeur, DESC
			        ),
			        REMOVEFILTERS ( Dim_Pays )
			    )
			VAR _nb =
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                ALL ( Dim_Pays[Code pays], Dim_Pays[Type de pays] ),
			                Dim_Pays[Type de pays] = "Pays" && NOT ISBLANK ( [Dépenses publiques (% PIB)] )
			            )
			        ),
			        REMOVEFILTERS ( Dim_Pays )
			    )
			VAR _est_pays = SELECTEDVALUE ( Dim_Pays[Type de pays] ) = "Pays"
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _valeur ) || ISBLANK ( _annee ), "Choisissez un pays et une année pour afficher la comparaison.",
			        NOT _est_pays,
			            "En " & _annee & ", la dépense publique représente en moyenne " & FORMAT ( _valeur, "0.0 %", "fr-FR" )
			                & " de la richesse produite pour l'ensemble « " & _pays & " ».",
			        "En " & _annee & ", la dépense publique représente " & FORMAT ( _valeur, "0.0 %", "fr-FR" )
			            & " de la richesse produite pour le pays « " & _pays & " » : rang " & _rang & " sur " & _nb
			            & " pays comparés (1 = dépense la plus élevée)."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 7992306f-6304-401c-b1d0-22d3fbcbc7b4

	/// Dette publique (au sens de Maastricht) à la dernière fin d'année de la période. Semi-additive : jamais additionnée dans le temps.
	measure 'Dette publique (M€)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Dette[date_id] )
			    RETURN CALCULATE ( SUM ( Fait_Dette[valeur_meur] ), Fait_Dette[date_id] = _d )
			)
		formatString: "#,0"
		displayFolder: 06 Dette
		lineageTag: d976c4fc-45bf-45e0-bf7b-addea53c45cf

	/// Dette consolidée par instrument, à la dernière fin d'année de la période.
	measure 'Dette par instrument (M€)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Dette_Instrument[date_id] )
			    RETURN CALCULATE ( SUM ( Fait_Dette_Instrument[valeur_meur] ), Fait_Dette_Instrument[date_id] = _d )
			)
		formatString: "#,0"
		displayFolder: 06 Dette
		lineageTag: d8ba8869-f0e5-4793-9756-20fb105b053d

	/// Dette consolidée par détenteur, à la dernière fin d'année de la période.
	measure 'Dette par détenteur (M€)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Detention_Dette[date_id] )
			    RETURN CALCULATE ( SUM ( Fait_Detention_Dette[valeur_meur] ), Fait_Detention_Dette[date_id] = _d )
			)
		formatString: "#,0"
		displayFolder: 06 Dette
		lineageTag: c12d0008-bc64-408f-80f7-c7f7273b6d78

	/// Dette publique en milliards d'euros.
	measure 'Dette publique (Md€)' = DIVIDE ( [Dette publique (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 06 Dette
		lineageTag: c8265af1-f0eb-4fa3-bf8b-572d1d8ca7b4

	/// Dette par instrument, en milliards d'euros.
	measure 'Dette par instrument (Md€)' = DIVIDE ( [Dette par instrument (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 06 Dette
		lineageTag: 644e1090-5398-4124-80be-fd81f78b7aa1

	/// Dette par détenteur, en milliards d'euros.
	measure 'Dette par détenteur (Md€)' = DIVIDE ( [Dette par détenteur (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 06 Dette
		lineageTag: e7c36604-6fb2-4256-80d2-5656033cc899

	/// Dette rapportée à la richesse produite (PIB) de la même année.
	measure 'Dette publique (% PIB)' =
			VAR _d = MAX ( Fait_Dette[date_id] )
			RETURN DIVIDE ( [Dette publique (M€)], CALCULATE ( [PIB (M€)], REMOVEFILTERS ( Dim_Date ), Dim_Date[date_id] = _d ) )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: 225f8549-4ca9-458c-bacf-e9187a9dbe2a

	/// Dette publique divisée par le nombre d'habitants.
	measure 'Dette publique par habitant (€)' =
			VAR _d = MAX ( Fait_Dette[date_id] )
			RETURN DIVIDE ( [Dette publique (M€)] * 1000000, CALCULATE ( [Population], REMOVEFILTERS ( Dim_Date ), Dim_Date[date_id] = _d ) )
		formatString: "#,0 ""€"""
		displayFolder: 06 Dette
		lineageTag: 6698ad8d-2a0f-4e90-8e4f-d9a9fcdf4788

	/// Part du détenteur dans la dette, à périmètre inchangé.
	measure 'Part de la dette détenue (%)' = DIVIDE ( [Dette par détenteur (M€)], CALCULATE ( [Dette par détenteur (M€)], REMOVEFILTERS ( Dim_Detenteur ) ) )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: b16f0825-f846-4d88-8d06-afafe1cf1446

	/// Part de la dette détenue par des investisseurs situés hors du pays.
	measure 'Part détenue par l''étranger (%)' = CALCULATE ( [Part de la dette détenue (%)], Dim_Detenteur[Groupe de détenteurs] = "Étranger" )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: d999793a-6c25-4562-ae82-8cad37afb741

	/// Taux auquel l'État emprunte à 10 ans sur les marchés, moyenne de la période.
	measure 'Taux d''emprunt à 10 ans' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), DIVIDE ( AVERAGE ( Fait_Taux_Marche[taux_pct] ), 100 ) )
		formatString: "0.00 %"
		displayFolder: 06 Dette
		lineageTag: 31b5a283-6cca-4ed3-abe6-bd997e8fa768

	/// Dette au 31 décembre de l'année précédente (base du taux moyen payé).
	measure 'Dette fin d''année précédente (M€)' =
			VAR _an = SELECTEDVALUE ( Dim_Date[Année] )
			RETURN
			    IF ( NOT ISBLANK ( _an ), CALCULATE ( [Dette publique (M€)], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _an - 1 ) )
		formatString: "#,0"
		displayFolder: 06 Dette
		lineageTag: 15987db5-d83c-4a17-9044-bdf43186dc8a

	/// Taux apparent : intérêts de l'année rapportés à la dette de fin d'année précédente.
	measure 'Taux moyen payé sur la dette' = IF ( NOT ISBLANK ( SELECTEDVALUE ( Dim_Date[Année] ) ), DIVIDE ( [Charge d'intérêts (M€)], [Dette fin d'année précédente (M€)] ) )
		formatString: "0.00 %"
		displayFolder: 06 Dette
		lineageTag: 95b4f5e3-07b6-463a-8c67-1b7c4902a2d1

	/// Croissance de la richesse produite, inflation comprise, par rapport à l'année précédente.
	measure 'Croissance du PIB en valeur (%)' =
			VAR _an = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _prec = CALCULATE ( [PIB (M€)], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _an - 1 )
			RETURN IF ( NOT ISBLANK ( _an ) && NOT ISBLANK ( _prec ), DIVIDE ( [PIB (M€)], _prec ) - 1 )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: 2c30f939-f2cb-4dbc-8ccc-7d56bc1debb8

	/// Ratio de dette au 31 décembre de l'année précédente.
	measure 'Dette (% PIB) l''année précédente' =
			VAR _an = SELECTEDVALUE ( Dim_Date[Année] )
			RETURN
			    IF ( NOT ISBLANK ( _an ), CALCULATE ( [Dette publique (% PIB)], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _an - 1 ) )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: 90fd8824-ff75-4610-bd5c-b74e2dbfb3a8

	/// Hausse (ou baisse) du ratio de dette sur l'année, en points de richesse produite.
	measure 'Variation de la dette (points de PIB)' =
			VAR _avant = [Dette (% PIB) l'année précédente]
			VAR _apres = [Dette publique (% PIB)]
			RETURN IF ( NOT ISBLANK ( _avant ) && NOT ISBLANK ( _apres ) && NOT ISBLANK ( SELECTEDVALUE ( Dim_Date[Année] ) ), ( _apres - _avant ) * 100 )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 06 Dette
		lineageTag: aabc7f02-1e05-411b-bde4-add5c4d3d5cd

	/// Ce que le déficit hors intérêts ajoute à la dette (négatif : un excédent hors intérêts la réduit).
	measure 'Déficit hors intérêts (points de PIB)' = IF ( NOT ISBLANK ( [Variation de la dette (points de PIB)] ), - DIVIDE ( [Solde primaire (M€)], [PIB (M€)] ) * 100 )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 06 Dette
		lineageTag: 63aa30f3-ee01-47bc-a92b-e5b1ffe2dbcb

	/// Ce que l'écart entre taux d'intérêt et croissance ajoute à la dette (négatif : la croissance l'allège).
	measure 'Effet boule de neige (points de PIB)' =
			VAR _i = [Taux moyen payé sur la dette]
			VAR _g = [Croissance du PIB en valeur (%)]
			VAR _d = [Dette (% PIB) l'année précédente]
			RETURN IF ( NOT ISBLANK ( [Variation de la dette (points de PIB)] ), _d * DIVIDE ( _i - _g, 1 + _g ) * 100 )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 06 Dette
		lineageTag: a2b38deb-755c-45f0-bfe2-837a8e9e5ffd

	/// Résidu : achats d'actifs, trésorerie, écarts entre comptabilité et décaissements (ajustement stock-flux).
	measure 'Autres facteurs (points de PIB)' =
			VAR _var = [Variation de la dette (points de PIB)]
			RETURN IF ( NOT ISBLANK ( _var ), _var - [Déficit hors intérêts (points de PIB)] - [Effet boule de neige (points de PIB)] )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 06 Dette
		lineageTag: 9b6fac8a-1f5c-44c4-a437-f386aa950c85

	/// La dette de l'année et son coût, en une phrase.
	measure 'Phrase : dette' =
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _dette = [Dette publique (Md€)]
			VAR _interets = DIVIDE ( [Charge d'intérêts (M€)], 1000 )
			VAR _taux = [Taux moyen payé sur la dette]
			RETURN
			    IF (
			        ISBLANK ( _annee ) || ISBLANK ( _dette ),
			        "Choisissez un pays et une année pour afficher les chiffres.",
			        "Fin " & _annee & ", la dette publique atteint " & FORMAT ( _dette, "#,0", "fr-FR" )
			            & " milliards d'euros, soit " & FORMAT ( [Dette publique (% PIB)], "0 %", "fr-FR" )
			            & " de la richesse produite en un an, ou " & FORMAT ( [Dette publique par habitant (€)], "#,0", "fr-FR" )
			            & " € par habitant. Ses intérêts ont coûté " & FORMAT ( _interets, "#,0", "fr-FR" )
			            & " milliards d'euros dans l'année"
			            & IF ( NOT ISBLANK ( _taux ), ", soit un taux moyen de " & FORMAT ( _taux, "0.0 %", "fr-FR" ), "" ) & "."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: fc7ad1ca-fce4-47f8-8eb8-4a129989b52f

	/// Pourquoi la dette a augmenté ou diminué, en une phrase.
	measure 'Phrase : boule de neige' =
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _i = [Taux moyen payé sur la dette]
			VAR _g = [Croissance du PIB en valeur (%)]
			VAR _var = [Variation de la dette (points de PIB)]
			VAR _def = [Déficit hors intérêts (points de PIB)]
			RETURN
			    IF (
			        ISBLANK ( _var ) || ISBLANK ( _i ) || ISBLANK ( _g ),
			        "",
			        "En " & _annee & ", le taux moyen payé sur la dette (" & FORMAT ( _i, "0.0 %", "fr-FR" ) & ") est "
			            & IF ( _i > _g, "supérieur", "inférieur" ) & " à la croissance de l'économie ("
			            & FORMAT ( _g, "0.0 %", "fr-FR" ) & ") : "
			            & IF ( _i > _g, "la dette grossit d'elle-même (effet boule de neige). ", "la croissance allège le poids de la dette. " )
			            & "Sur l'année, elle a " & IF ( _var >= 0, "augmenté", "diminué" ) & " de "
			            & FORMAT ( ABS ( _var ), "0.0", "fr-FR" ) & " points de richesse produite"
			            & IF ( _def > 0, ", dont " & FORMAT ( _def, "0.0", "fr-FR" ) & " points dus au déficit hors intérêts.", "." )
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 4fdd1844-a0e2-40bd-97fd-3b4a332db895

	/// À qui la dette est due, en une phrase.
	measure 'Phrase : détenteurs' =
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _etr = [Part détenue par l'étranger (%)]
			VAR _bc = CALCULATE ( [Part de la dette détenue (%)], Dim_Detenteur[Code détenteur] = "S121" )
			RETURN
			    IF (
			        ISBLANK ( _etr ),
			        "Le détail par détenteur n'est pas publié pour cette année (il l'est depuis 2020 pour la plupart des pays).",
			        "Fin " & _annee & ", " & FORMAT ( _etr, "0 %", "fr-FR" ) & " de la dette est détenue par des investisseurs étrangers, "
			            & FORMAT ( _bc, "0 %", "fr-FR" ) & " par la banque centrale et "
			            & FORMAT ( 1 - _etr - _bc, "0 %", "fr-FR" ) & " par les autres prêteurs du pays (banques, assureurs, ménages…)."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 0476d441-2357-42db-ae65-e7d0d6a4b5f3

	/// Dette de Maastricht à la dernière fin de trimestre de la période (Eurostat). Semi-additive.
	measure 'Dette trimestrielle (M€)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Dette_Trimestrielle[date_id] )
			    RETURN CALCULATE ( SUM ( Fait_Dette_Trimestrielle[valeur_meur] ), Fait_Dette_Trimestrielle[date_id] = _d )
			)
		formatString: "#,0"
		displayFolder: 07 Trimestriel
		lineageTag: 15bc735e-783f-464e-8980-89bb36261ef3

	/// Dette trimestrielle en milliards d'euros.
	measure 'Dette trimestrielle (Md€)' = DIVIDE ( [Dette trimestrielle (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 07 Trimestriel
		lineageTag: b887a808-0dac-44f8-864b-32e01a28dbce

	/// Dette en fin de trimestre rapportée à la richesse produite sur les quatre derniers trimestres.
	measure 'Dette trimestrielle (% PIB)' =
			VAR _d = MAX ( Fait_Dette_Trimestrielle[date_id] )
			VAR _pib = CALCULATE ( SUM ( Fait_Macro_Trimestriel[pib_4t_meur] ), REMOVEFILTERS ( Dim_Date ), Dim_Date[date_id] = _d, Fait_Macro_Trimestriel[correction] = "BRUT" )
			RETURN DIVIDE ( [Dette trimestrielle (M€)], _pib )
		formatString: "0.0 %"
		displayFolder: 07 Trimestriel
		lineageTag: 280057f6-3a25-4380-b7d1-ef0c5b5ef374

	/// France : part de la dette consolidée portée par chaque administration, à la dernière fin de trimestre de la période (INSEE).
	measure 'Contribution à la dette (M€)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Dette_Contributions[date_id] )
			    RETURN CALCULATE ( SUM ( Fait_Dette_Contributions[valeur_meur] ), Fait_Dette_Contributions[date_id] = _d )
			)
		formatString: "#,0"
		displayFolder: 07 Trimestriel
		lineageTag: a3afb8a0-ad6b-4e9b-81a3-6dae41cedd37

	/// Contribution à la dette, en milliards d'euros.
	measure 'Contribution à la dette (Md€)' = DIVIDE ( [Contribution à la dette (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 07 Trimestriel
		lineageTag: 9d01931d-b40d-476a-85a0-8e53da9ccf5f

	/// Date (AAAAMMJJ) du dernier trimestre publié pour le pays : INSEE pour la France, Eurostat sinon.
	measure 'Date du dernier trimestre connu' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _insee = CALCULATE ( MAX ( Fait_Dette_Contributions[date_id] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ) )
			    VAR _eurostat = CALCULATE ( MAX ( Fait_Dette_Trimestrielle[date_id] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ) )
			    RETURN MAX ( _insee, _eurostat )
			)
		formatString: "0"
		displayFolder: 07 Trimestriel
		lineageTag: c5f5f138-3ba8-4c93-bd29-2fc0f2b38d9b

	/// Dette au dernier trimestre publié, quelle que soit l'année choisie.
	measure 'Dette au dernier trimestre connu (M€)' =
			VAR _d = [Date du dernier trimestre connu]
			VAR _insee = CALCULATE ( SUM ( Fait_Dette_Contributions[valeur_meur] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ), Fait_Dette_Contributions[date_id] = _d )
			VAR _eurostat = CALCULATE ( SUM ( Fait_Dette_Trimestrielle[valeur_meur] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ), Fait_Dette_Trimestrielle[date_id] = _d )
			RETURN IF ( NOT ISBLANK ( _d ), COALESCE ( _insee, _eurostat ) )
		formatString: "#,0"
		displayFolder: 07 Trimestriel
		lineageTag: 09d0a682-0aff-4233-9136-b6013d46b6fb

	/// Dette au dernier trimestre publié, en milliards d'euros.
	measure 'Dette au dernier trimestre connu (Md€)' = DIVIDE ( [Dette au dernier trimestre connu (M€)], 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 07 Trimestriel
		lineageTag: 630ce1a9-f0b8-4ffa-9e32-9f468090b91d

	/// Dette au dernier trimestre publié, rapportée à la richesse produite sur un an.
	measure 'Dette au dernier trimestre connu (% PIB)' =
			VAR _d = [Date du dernier trimestre connu]
			VAR _pib = CALCULATE ( SUM ( Fait_Macro_Trimestriel[pib_4t_meur] ), REMOVEFILTERS ( Dim_Date ), Dim_Date[date_id] = _d, Fait_Macro_Trimestriel[correction] = "BRUT" )
			RETURN DIVIDE ( [Dette au dernier trimestre connu (M€)], _pib )
		formatString: "0.0 %"
		displayFolder: 07 Trimestriel
		lineageTag: e6f3d6f6-f066-4d6b-9efc-68fe7176e581

	/// Hausse de la dette entre le même trimestre de l'année précédente et le dernier trimestre publié.
	measure 'Hausse de la dette sur un an (Md€)' =
			VAR _d = [Date du dernier trimestre connu]
			VAR _avant_insee = CALCULATE ( SUM ( Fait_Dette_Contributions[valeur_meur] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ), Fait_Dette_Contributions[date_id] = _d - 10000 )
			VAR _avant_eurostat = CALCULATE ( SUM ( Fait_Dette_Trimestrielle[valeur_meur] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ), Fait_Dette_Trimestrielle[date_id] = _d - 10000 )
			VAR _avant = COALESCE ( _avant_insee, _avant_eurostat )
			RETURN IF ( NOT ISBLANK ( _avant ), DIVIDE ( [Dette au dernier trimestre connu (M€)] - _avant, 1000 ) )
		formatString: "+#,0 ""Md€"";-#,0 ""Md€"""
		displayFolder: 07 Trimestriel
		lineageTag: 4f7e3b37-36e8-42e7-b792-90831885e7ae

	/// Libellé du dernier trimestre publié (« 2e trimestre 2026 »).
	measure 'Dernier trimestre connu' =
			VAR _d = [Date du dernier trimestre connu]
			VAR _t = MOD ( INT ( _d / 100 ), 100 ) / 3
			RETURN
			    IF (
			        ISBLANK ( _d ),
			        "Choisissez un pays",
			        SWITCH ( _t, 1, "1er", 2, "2e", 3, "3e", "4e" ) & " trimestre " & INT ( _d / 10000 )
			    )
		displayFolder: 07 Trimestriel
		lineageTag: bbb35a8d-f03f-4113-86bc-0261edba64e7

	/// Solde public du trimestre, corrigé des variations saisonnières, en % de la richesse produite du trimestre.
	measure 'Solde trimestriel (% PIB)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    DIVIDE (
			        CALCULATE ( SUM ( Fait_Comptes_APU_Trimestriels[valeur_meur] ), Fait_Comptes_APU_Trimestriels[agregat_code] = "SOLDE", Fait_Comptes_APU_Trimestriels[correction] = "CVS" ),
			        CALCULATE ( SUM ( Fait_Macro_Trimestriel[pib_meur] ), Fait_Macro_Trimestriel[correction] = "CVS" )
			    )
			)
		formatString: "0.0 %"
		displayFolder: 07 Trimestriel
		lineageTag: ea3080b9-9588-4695-bc58-8c51c4948397

	/// Taux des emprunts de l'État allemand à 10 ans, la référence de la zone euro.
	measure 'Taux à 10 ans de l''Allemagne' = CALCULATE ( DIVIDE ( AVERAGE ( Fait_Taux_Marche[taux_pct] ), 100 ), REMOVEFILTERS ( Dim_Pays ), Dim_Pays[Code pays] = "DE" )
		formatString: "0.00 %"
		displayFolder: 06 Dette
		lineageTag: 5dd16397-4d02-4f75-941f-384d62409d25

	/// Supplément de taux payé par le pays par rapport à l'Allemagne, en points de pourcentage.
	measure 'Écart de taux avec l''Allemagne (points)' =
			VAR _pays = [Taux d'emprunt à 10 ans]
			VAR _de = [Taux à 10 ans de l'Allemagne]
			RETURN IF ( NOT ISBLANK ( _pays ) && NOT ISBLANK ( _de ), ( _pays - _de ) * 100 )
		formatString: "+0.00 ""pt"";-0.00 ""pt"";0.00 ""pt"""
		displayFolder: 06 Dette
		lineageTag: 496adec7-63ed-4c4e-ad30-1ce83dd9e330

	/// Taux moyens des emprunts d'État de la zone euro selon leur durée, au dernier jour connu de l'année choisie.
	measure 'Courbe des taux (fin de l''année choisie)' =
			VAR _an = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _d = CALCULATE ( MAX ( Fait_Courbe_Taux[date_id] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Pays ), Dim_Date[Année] = _an )
			RETURN
			    IF (
			        NOT ISBLANK ( _an ),
			        CALCULATE (
			            DIVIDE ( AVERAGE ( Fait_Courbe_Taux[taux_pct] ), 100 ),
			            REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Pays ),
			            Fait_Courbe_Taux[date_id] = _d,
			            Fait_Courbe_Taux[Notation] = "Ensemble des États de la zone euro"
			        )
			    )
		formatString: "0.00 %"
		displayFolder: 06 Dette
		lineageTag: 75139eec-abec-474f-9de0-cfbf5f09426f

	/// La même courbe, douze mois plus tôt.
	measure 'Courbe des taux (un an plus tôt)' =
			VAR _an = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _d = CALCULATE ( MAX ( Fait_Courbe_Taux[date_id] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Pays ), Dim_Date[Année] = _an ) - 10000
			RETURN
			    IF (
			        NOT ISBLANK ( _an ),
			        CALCULATE (
			            DIVIDE ( AVERAGE ( Fait_Courbe_Taux[taux_pct] ), 100 ),
			            REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Pays ),
			            Fait_Courbe_Taux[date_id] = _d,
			            Fait_Courbe_Taux[Notation] = "Ensemble des États de la zone euro"
			        )
			    )
		formatString: "0.00 %"
		displayFolder: 06 Dette
		lineageTag: 011f8b8d-b4e4-4c7f-92c9-6fdb9c8bb1b7

	/// France : encours des titres émis par l'État, au dernier mois de la période.
	measure 'Dette négociable de l''État (Md€)' =
			VAR _d = MAX ( Fait_Dette_Negociable_Etat[date_id] )
			RETURN DIVIDE ( CALCULATE ( SUM ( Fait_Dette_Negociable_Etat[valeur_meur] ), Fait_Dette_Negociable_Etat[date_id] = _d, Dim_Composante_Dette_Etat[Axe] = "Durée" ), 1000 )
		formatString: "#,0 ""Md€"""
		displayFolder: 06 Dette
		lineageTag: e264a048-075a-426c-bac8-f936ccf5d1c1

	/// France : part de la dette négociable de l'État dont le remboursement suit l'inflation.
	measure 'Part indexée sur l''inflation (%)' =
			VAR _d = MAX ( Fait_Dette_Negociable_Etat[date_id] )
			VAR _total = CALCULATE ( SUM ( Fait_Dette_Negociable_Etat[valeur_meur] ), REMOVEFILTERS ( Dim_Composante_Dette_Etat ), Fait_Dette_Negociable_Etat[date_id] = _d, Dim_Composante_Dette_Etat[Axe] = "Type de taux" )
			VAR _indexee = CALCULATE ( SUM ( Fait_Dette_Negociable_Etat[valeur_meur] ), REMOVEFILTERS ( Dim_Composante_Dette_Etat ), Fait_Dette_Negociable_Etat[date_id] = _d, Dim_Composante_Dette_Etat[Code composante] = "INDEXEE" )
			RETURN DIVIDE ( _indexee, _total )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: 24d7df2d-f9e4-4acd-8249-e4c9d2e35a86

	/// France : part de la dette négociable de l'État à rembourser en un an ou moins à l'émission.
	measure 'Part à court terme (%)' =
			VAR _d = MAX ( Fait_Dette_Negociable_Etat[date_id] )
			VAR _total = CALCULATE ( SUM ( Fait_Dette_Negociable_Etat[valeur_meur] ), REMOVEFILTERS ( Dim_Composante_Dette_Etat ), Fait_Dette_Negociable_Etat[date_id] = _d, Dim_Composante_Dette_Etat[Axe] = "Durée" )
			VAR _court = CALCULATE ( SUM ( Fait_Dette_Negociable_Etat[valeur_meur] ), REMOVEFILTERS ( Dim_Composante_Dette_Etat ), Fait_Dette_Negociable_Etat[date_id] = _d, Dim_Composante_Dette_Etat[Code composante] = "COURT_TERME" )
			RETURN DIVIDE ( _court, _total )
		formatString: "0.0 %"
		displayFolder: 06 Dette
		lineageTag: f89ac3e6-09ce-4d9d-846a-ee52571e7414

	/// Le dernier point de la dette, en une phrase.
	measure 'Phrase : dette trimestrielle' =
			VAR _md = [Dette au dernier trimestre connu (Md€)]
			VAR _hausse = [Hausse de la dette sur un an (Md€)]
			RETURN
			    IF (
			        ISBLANK ( _md ),
			        "Choisissez un pays pour afficher les chiffres.",
			        "Au " & [Dernier trimestre connu] & ", la dette publique atteint " & FORMAT ( _md, "#,0", "fr-FR" )
			            & " milliards d'euros (" & FORMAT ( [Dette au dernier trimestre connu (% PIB)], "0.0 %", "fr-FR" )
			            & " de la richesse produite sur un an)"
			            & IF ( NOT ISBLANK ( _hausse ),
			                ". En un an, elle a " & IF ( _hausse >= 0, "augmenté", "diminué" ) & " de "
			                    & FORMAT ( ABS ( _hausse ), "#,0", "fr-FR" ) & " milliards d'euros, soit environ "
			                    & FORMAT ( ABS ( _hausse ) * 1000 / 365, "#,0", "fr-FR" ) & " millions d'euros par jour.",
			                "." )
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 4227eac9-6914-49d7-8ee7-e97a30aef7aa

	/// Le coût de l'emprunt, en une phrase.
	measure 'Phrase : taux' =
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _taux = [Taux d'emprunt à 10 ans]
			VAR _ecart = [Écart de taux avec l'Allemagne (points)]
			VAR _index = [Part indexée sur l'inflation (%)]
			RETURN
			    IF (
			        ISBLANK ( _taux ) || ISBLANK ( _annee ),
			        "Choisissez un pays et une année pour afficher les chiffres.",
			        "En " & _annee & ", l'État a emprunté à 10 ans au taux moyen de " & FORMAT ( _taux, "0.0 %", "fr-FR" )
			            & IF ( NOT ISBLANK ( _ecart ) && SELECTEDVALUE ( Dim_Pays[Code pays] ) <> "DE",
			                ", soit " & FORMAT ( ABS ( _ecart ), "0.00", "fr-FR" ) & " point "
			                    & IF ( _ecart >= 0, "de plus", "de moins" ) & " que l'Allemagne",
			                "" )
			            & "."
			            & IF ( NOT ISBLANK ( _index ),
			                " " & FORMAT ( _index, "0 %", "fr-FR" )
			                    & " des titres de l'État sont indexés sur l'inflation : leur coût suit la hausse des prix.",
			                "" )
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 8cda1e9d-ddcf-45a3-a2c7-0fdd0234b057

	/// Dernière année de dette publiée pour le pays : point de départ de la projection.
	measure 'Année de départ' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    INT ( CALCULATE ( MAX ( Fait_Dette[date_id] ), REMOVEFILTERS ( Dim_Date ), REMOVEFILTERS ( Dim_Sous_Secteur ) ) / 10000 )
			)
		formatString: "0"
		displayFolder: 30 Laboratoire
		lineageTag: 5602e6c0-64ed-47f4-9873-40370bda44fd

	/// Dette en % de la richesse produite l'année de départ.
	measure 'Dette de départ (% PIB)' =
			VAR _t0 = [Année de départ]
			RETURN CALCULATE ( [Dette publique (% PIB)], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _t0 )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: c3b8d498-974a-43f7-a6f6-08d17f2e8502

	/// Taux moyen payé sur la dette l'année de départ.
	measure 'Taux moyen observé' =
			VAR _t0 = [Année de départ]
			RETURN CALCULATE ( [Taux moyen payé sur la dette], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _t0 )
		formatString: "0.00 %"
		displayFolder: 30 Laboratoire
		lineageTag: 2fee9ef4-8b22-4322-a2c1-f3fe151504a7

	/// Solde hors intérêts (solde primaire) l'année de départ ; négatif = déficit.
	measure 'Solde hors intérêts observé (% PIB)' =
			VAR _t0 = [Année de départ]
			RETURN CALCULATE ( DIVIDE ( [Solde primaire (M€)], [PIB (M€)] ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _t0 )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 6d2f84bc-3c9b-412d-bb18-2c789b53cb35

	/// Croissance hors inflation retenue (1 % par défaut).
	measure 'Croissance réelle retenue' = SELECTEDVALUE ( 'Param Croissance'[Croissance réelle (% par an)], 1 ) / 100
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 71f348a1-2fec-4b99-9b00-2b9ab67ef4ff

	/// Inflation retenue (1,8 % par défaut).
	measure 'Inflation retenue' = SELECTEDVALUE ( 'Param Inflation'[Inflation (% par an)], 1.8 ) / 100
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 977448b0-080a-44d6-8873-16d8dc0ca93e

	/// Croissance de la richesse produite, inflation comprise.
	measure 'Croissance en valeur retenue' = ( 1 + [Croissance réelle retenue] ) * ( 1 + [Inflation retenue] ) - 1
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 719c7c9c-e4de-4591-99c0-51eadb0f86af

	/// Taux moyen payé sur la dette retenu : taux observé + écart choisi.
	measure 'Taux retenu' = [Taux moyen observé] + SELECTEDVALUE ( 'Param Ecart Taux'[Écart de taux (points)], 0 ) / 100
		formatString: "0.00 %"
		displayFolder: 30 Laboratoire
		lineageTag: cb3be95e-56e1-493c-acb1-8f5bcd4ec034

	/// Solde hors intérêts retenu : solde observé + effort choisi.
	measure 'Solde hors intérêts retenu (% PIB)' = [Solde hors intérêts observé (% PIB)] + SELECTEDVALUE ( 'Param Effort'[Effort sur le solde hors intérêts (points de PIB)], 0 ) / 100
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 7b5f019f-9800-4c3f-9ebe-955aa34a9f58

	/// Dette projetée chaque année : d(t) = d(t−1) × (1 + taux) / (1 + croissance en valeur) − solde hors intérêts.
	measure 'Dette projetée (% PIB)' =
			VAR _t0 = [Année de départ]
			VAR _n = SELECTEDVALUE ( Dim_Date[Année] ) - _t0
			VAR _d0 = [Dette de départ (% PIB)]
			VAR _f = DIVIDE ( 1 + [Taux retenu], 1 + [Croissance en valeur retenue] )
			VAR _sp = [Solde hors intérêts retenu (% PIB)]
			RETURN
			    IF (
			        NOT ISBLANK ( _d0 ) && _n >= 0 && _n <= 10,
			        IF (
			            ABS ( _f - 1 ) < 0.000001,
			            _d0 - _sp * _n,
			            _d0 * POWER ( _f, _n ) - _sp * DIVIDE ( POWER ( _f, _n ) - 1, _f - 1 )
			        )
			    )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 0cab5ba1-68aa-4792-922a-38fa0a565083

	/// Dette projetée dix ans après l'année de départ.
	measure 'Dette dans 10 ans (% PIB)' =
			VAR _t0 = [Année de départ]
			RETURN CALCULATE ( [Dette projetée (% PIB)], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _t0 + 10 )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 2a3cc627-7c66-4d51-a756-a74374bb3d5a

	/// Dernière année de la projection.
	measure 'Année d''arrivée' = [Année de départ] + 10
		formatString: "0"
		displayFolder: 30 Laboratoire
		lineageTag: 453c3c20-b24f-4f87-b99b-29af3bab87eb

	/// Solde hors intérêts nécessaire pour que le ratio de dette reste constant : d × (taux − croissance) / (1 + croissance).
	measure 'Solde hors intérêts qui stabilise la dette (% PIB)' =
			VAR _g = [Croissance en valeur retenue]
			RETURN DIVIDE ( [Dette de départ (% PIB)] * ( [Taux retenu] - _g ), 1 + _g )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: e619ae4b-3995-4d2c-aff0-51d42da98f7e

	/// Charge d'intérêts projetée la dernière année, en % de la richesse produite.
	measure 'Intérêts dans 10 ans (% PIB)' =
			VAR _t0 = [Année de départ]
			VAR _d9 = CALCULATE ( [Dette projetée (% PIB)], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _t0 + 9 )
			RETURN DIVIDE ( [Taux retenu] * _d9, 1 + [Croissance en valeur retenue] )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 27e5b9bd-5a93-4ba7-83b6-2daf12d3728d

	/// Recettes de TVA supplémentaires si tous les taux varient dans la même proportion, sans effet sur la consommation.
	measure 'Effet TVA (M€)' = CALCULATE ( [Montant APU (M€)], Dim_Transaction[Code nature] = "D211_REC" ) * SELECTEDVALUE ( 'Param TVA'[Hausse des taux de TVA (%)], 0 ) / 100
		formatString: "#,0"
		displayFolder: 30 Laboratoire
		lineageTag: 0144a7f2-3dfd-493b-b576-1cc5312d2580

	/// Effet sur le solde d'une variation des dépenses du domaine choisi (tous les domaines si aucun n'est choisi).
	measure 'Effet dépenses du domaine (M€)' =
			- CALCULATE ( [Dépenses par fonction (M€)], TREATAS ( VALUES ( 'Choix Domaine'[Domaine] ), Dim_COFOG[Fonction] ) )
			    * SELECTEDVALUE ( 'Param Depense Domaine'[Variation des dépenses du domaine (%)], 0 ) / 100
		formatString: "#,0"
		displayFolder: 30 Laboratoire
		lineageTag: 270edfef-1484-41ba-8f18-a4fa2bd0f6ff

	/// Effet sur le solde d'une variation de la rémunération des agents publics.
	measure 'Effet salaires publics (M€)' = - CALCULATE ( [Montant APU (M€)], Dim_Transaction[Code nature] = "D1_PAY" ) * SELECTEDVALUE ( 'Param Salaires'[Variation des salaires publics (%)], 0 ) / 100
		formatString: "#,0"
		displayFolder: 30 Laboratoire
		lineageTag: 0a9ed4c3-c57c-40f5-96bd-ba7f15adb9e0

	/// Effet sur le solde d'une variation des prestations sociales (en espèces et en nature).
	measure 'Effet prestations (M€)' = - CALCULATE ( [Montant APU (M€)], Dim_Transaction[Code nature] IN { "D62_PAY", "D632_PAY" } ) * SELECTEDVALUE ( 'Param Prestations'[Variation des prestations sociales (%)], 0 ) / 100
		formatString: "#,0"
		displayFolder: 30 Laboratoire
		lineageTag: 83e3fe98-70bd-40e7-98a2-027fedda5438

	/// Somme des effets des leviers (positif : le solde s'améliore). Les leviers peuvent se recouper.
	measure 'Effet total sur le solde (M€)' = [Effet TVA (M€)] + [Effet dépenses du domaine (M€)] + [Effet salaires publics (M€)] + [Effet prestations (M€)]
		formatString: "#,0"
		displayFolder: 30 Laboratoire
		lineageTag: 1f731055-1ce2-4d15-93f7-7075fb91b228

	/// Effet TVA, en milliards d'euros.
	measure 'Effet TVA (Md€)' = DIVIDE ( [Effet TVA (M€)], 1000 )
		formatString: "+#,0 ""Md€"";-#,0 ""Md€"";0 ""Md€"""
		displayFolder: 30 Laboratoire
		lineageTag: e59236e4-abc4-47cf-9b43-3630a2b4f6b9

	/// Effet dépenses du domaine, en milliards d'euros.
	measure 'Effet dépenses du domaine (Md€)' = DIVIDE ( [Effet dépenses du domaine (M€)], 1000 )
		formatString: "+#,0 ""Md€"";-#,0 ""Md€"";0 ""Md€"""
		displayFolder: 30 Laboratoire
		lineageTag: 322f0b0d-0440-423a-8ffb-41154fbfd8aa

	/// Effet salaires publics, en milliards d'euros.
	measure 'Effet salaires publics (Md€)' = DIVIDE ( [Effet salaires publics (M€)], 1000 )
		formatString: "+#,0 ""Md€"";-#,0 ""Md€"";0 ""Md€"""
		displayFolder: 30 Laboratoire
		lineageTag: c6890ea3-47bd-4176-8dd2-207ecd1445d1

	/// Effet prestations, en milliards d'euros.
	measure 'Effet prestations (Md€)' = DIVIDE ( [Effet prestations (M€)], 1000 )
		formatString: "+#,0 ""Md€"";-#,0 ""Md€"";0 ""Md€"""
		displayFolder: 30 Laboratoire
		lineageTag: 791fbf0c-048f-4e25-9ad8-c43adf4ff547

	/// Effet total sur le solde, en milliards d'euros.
	measure 'Effet total sur le solde (Md€)' = DIVIDE ( [Effet total sur le solde (M€)], 1000 )
		formatString: "+#,0 ""Md€"";-#,0 ""Md€"";0 ""Md€"""
		displayFolder: 30 Laboratoire
		lineageTag: dcd09c90-1dcb-4181-8d8a-f22bffc92a0a

	/// Effet total sur le solde, par habitant.
	measure 'Effet total par habitant (€)' = DIVIDE ( [Effet total sur le solde (M€)] * 1000000, [Population] )
		formatString: "+#,0 ""€"";-#,0 ""€"";0 ""€"""
		displayFolder: 30 Laboratoire
		lineageTag: b7d99b7f-728a-4cf7-841d-cd6cffe0521e

	/// Solde public de l'année choisie après application des leviers.
	measure 'Solde simulé (% PIB)' = DIVIDE ( [Solde public (M€)] + [Effet total sur le solde (M€)], [PIB (M€)] )
		formatString: "0.0 %"
		displayFolder: 30 Laboratoire
		lineageTag: 141fec75-8af2-4ccd-9c2a-5da0c1220a16

	/// Le résultat de la projection, en une phrase.
	measure 'Phrase : projection' =
			VAR _t0 = [Année de départ]
			VAR _sp = [Solde hors intérêts retenu (% PIB)]
			VAR _stab = [Solde hors intérêts qui stabilise la dette (% PIB)]
			VAR _fin = [Dette dans 10 ans (% PIB)]
			RETURN
			    IF (
			        ISBLANK ( _fin ),
			        "Choisissez un pays pour lancer la projection.",
			        "Avec une croissance de " & FORMAT ( [Croissance réelle retenue], "0.0 %", "fr-FR" )
			            & " par an, une inflation de " & FORMAT ( [Inflation retenue], "0.0 %", "fr-FR" )
			            & ", un taux moyen de " & FORMAT ( [Taux retenu], "0.0 %", "fr-FR" )
			            & " et un " & IF ( _sp < 0, "déficit", "excédent" ) & " hors intérêts de "
			            & FORMAT ( ABS ( _sp ), "0.0 %", "fr-FR" ) & " de la richesse produite, la dette passerait de "
			            & FORMAT ( [Dette de départ (% PIB)], "0 %", "fr-FR" ) & " en " & _t0 & " à "
			            & FORMAT ( _fin, "0 %", "fr-FR" ) & " en " & ( _t0 + 10 ) & ". Pour la stabiliser, il faudrait "
			            & IF ( _stab < 0, "un déficit hors intérêts d'au plus ", "un excédent hors intérêts de " )
			            & FORMAT ( ABS ( _stab ), "0.0 %", "fr-FR" ) & "."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: d199e7b2-84e8-42f5-8448-724ec21ffbf0

	/// Le résultat de la simulation, en une phrase.
	measure 'Phrase : simulation' =
			VAR _annee = SELECTEDVALUE ( Dim_Date[Année] )
			VAR _avant = [Solde public (% PIB)]
			VAR _apres = [Solde simulé (% PIB)]
			VAR _effet = [Effet total sur le solde (Md€)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _avant ) || ISBLANK ( _annee ), "Choisissez un pays et une année pour lancer la simulation.",
			        _effet = 0, "Déplacez un curseur pour voir l'effet d'une mesure sur le solde de " & _annee & ".",
			        "Avec ces mesures, le solde public de " & _annee & " passerait de "
			            & FORMAT ( _avant, "0.0 %", "fr-FR" ) & " à " & FORMAT ( _apres, "0.0 %", "fr-FR" )
			            & " de la richesse produite (" & FORMAT ( _effet, "+#,0;-#,0", "fr-FR" ) & " milliards d'euros, soit "
			            & FORMAT ( [Effet total par habitant (€)], "+#,0;-#,0", "fr-FR" ) & " € par habitant)."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: f8763dcc-780d-488e-835b-7f179fcd9db5

	/// Valeur prévue (ou réalisée, pour la ligne « Réalité ») de l'indicateur choisi.
	measure 'Valeur prévue' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ) && HASONEVALUE ( Dim_Variable_Prevision[Code variable] ), DIVIDE ( AVERAGE ( Fait_Previsions[valeur] ), 100 ) )
		formatString: "0.0 %"
		displayFolder: 31 Prévisions
		lineageTag: b2c80982-948f-4110-a503-44d3027342e6

	/// Moyenne de (prévu − réalisé), en points.
	measure 'Écart moyen (points)' = IF ( HASONEVALUE ( Dim_Variable_Prevision[Code variable] ), AVERAGE ( Fait_Previsions[ecart] ) )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 31 Prévisions
		lineageTag: 331cec55-edb8-482d-b78a-7b247045e0f9

	/// Écart moyen orienté : positif si les prévisions étaient trop optimistes (solde ou croissance trop hauts, dette trop basse).
	measure 'Biais d''optimisme (points)' = IF ( HASONEVALUE ( Dim_Variable_Prevision[Code variable] ), AVERAGE ( Fait_Previsions[ecart_optimisme] ) )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 31 Prévisions
		lineageTag: a7896755-e8d1-4a34-a2ae-abee9f56c128

	/// Erreur moyenne, dans un sens ou dans l'autre, en points.
	measure 'Erreur absolue moyenne (points)' =
			IF (
			    HASONEVALUE ( Dim_Variable_Prevision[Code variable] ),
			    AVERAGEX ( FILTER ( Fait_Previsions, NOT ISBLANK ( Fait_Previsions[ecart] ) ), ABS ( Fait_Previsions[ecart] ) )
			)
		formatString: "0.0 ""pt"""
		displayFolder: 31 Prévisions
		lineageTag: 1cfbd182-53a4-4751-9ac9-5495de5c0351

	/// Nombre de prévisions dont la valeur réalisée est connue.
	measure 'Prévisions comparées' = COUNTROWS ( FILTER ( Fait_Previsions, NOT ISBLANK ( Fait_Previsions[ecart] ) ) )
		formatString: "0"
		displayFolder: 31 Prévisions
		lineageTag: 1992da48-c370-4d3f-81ca-cd4d74d29ed1

	/// Biais d'optimisme (points), pour les prévisions de l'année suivante.
	measure 'Biais d''optimisme à un an (points)' = CALCULATE ( [Biais d'optimisme (points)], Fait_Previsions[Horizon (années)] = 1 )
		formatString: "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt"""
		displayFolder: 31 Prévisions
		lineageTag: 014a2f87-26d2-4e6b-8291-c7f023dc5589

	/// Erreur absolue moyenne (points), pour les prévisions de l'année suivante.
	measure 'Erreur absolue moyenne à un an (points)' = CALCULATE ( [Erreur absolue moyenne (points)], Fait_Previsions[Horizon (années)] = 1 )
		formatString: "0.0 ""pt"""
		displayFolder: 31 Prévisions
		lineageTag: b02859c8-08a6-49d3-a7d7-42d2976cc30a

	/// Prévisions comparées, pour les prévisions de l'année suivante.
	measure 'Prévisions comparées à un an' = CALCULATE ( [Prévisions comparées], Fait_Previsions[Horizon (années)] = 1 )
		formatString: "0"
		displayFolder: 31 Prévisions
		lineageTag: e006e585-d186-4e15-8147-67f522bd4f73

	/// La dernière prévision publiée, en une phrase.
	measure 'Phrase : dernière prévision' =
			VAR _derniere = CALCULATE ( MAX ( Dim_Edition_Prevision[ordre_tri] ), REMOVEFILTERS ( Dim_Date ), Dim_Edition_Prevision[Est une prévision] = TRUE (), Fait_Previsions )
			VAR _edition = CALCULATE ( FIRSTNONBLANK ( Dim_Edition_Prevision[Édition], 1 ), REMOVEFILTERS ( Dim_Edition_Prevision ), Dim_Edition_Prevision[ordre_tri] = _derniere )
			VAR _an = INT ( _derniere / 100 )
			VAR _v0 = CALCULATE ( [Valeur prévue], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _an, Dim_Edition_Prevision[ordre_tri] = _derniere )
			VAR _v1 = CALCULATE ( [Valeur prévue], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _an + 1, Dim_Edition_Prevision[ordre_tri] = _derniere )
			VAR _v2 = CALCULATE ( [Valeur prévue], REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _an + 2, Dim_Edition_Prevision[ordre_tri] = _derniere )
			VAR _t0 = IF ( NOT ISBLANK ( _v0 ), FORMAT ( _v0, "0.0 %", "fr-FR" ) & " en " & _an )
			VAR _t1 = IF ( NOT ISBLANK ( _v1 ), FORMAT ( _v1, "0.0 %", "fr-FR" ) & " en " & ( _an + 1 ) )
			VAR _t2 = IF ( NOT ISBLANK ( _v2 ), FORMAT ( _v2, "0.0 %", "fr-FR" ) & " en " & ( _an + 2 ) )
			VAR _liste = _t0 & IF ( _t0 <> "" && _t1 <> "", ", " ) & _t1 & IF ( ( _t0 <> "" || _t1 <> "" ) && _t2 <> "", ", " ) & _t2
			RETURN
			    IF (
			        ISBLANK ( _derniere ) || NOT HASONEVALUE ( Dim_Variable_Prevision[Code variable] ) || _liste = "",
			        "Choisissez un pays et un indicateur.",
			        "Dernière prévision publiée (" & _edition & ") pour « " & SELECTEDVALUE ( Dim_Variable_Prevision[Indicateur prévu] ) & " » : "
			            & _liste & "."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: f038b4ec-c1e3-4ee0-bca5-caddc2112d99

	/// Le biais des prévisions à un an, en une phrase.
	measure 'Phrase : biais des prévisions' =
			VAR _biais = [Biais d'optimisme à un an (points)]
			VAR _abs = [Erreur absolue moyenne à un an (points)]
			VAR _n = [Prévisions comparées à un an]
			VAR _inst = SWITCH ( SELECTEDVALUE ( Dim_Edition_Prevision[Institution] ), "Commission européenne", "de la Commission européenne", "FMI", "du FMI", "de l'ensemble des institutions" )
			RETURN
			    IF (
			        ISBLANK ( _biais ) || NOT HASONEVALUE ( Dim_Pays[Code pays] ),
			        "Choisissez un pays et un indicateur : aucune prévision comparable à la réalité pour cette sélection.",
			        "Pour l'année suivante, les prévisions " & _inst & " sur « " & SELECTEDVALUE ( Dim_Variable_Prevision[Indicateur prévu] )
			            & " » ont été en moyenne " & IF ( _biais >= 0, "trop optimistes", "trop pessimistes" ) & " de "
			            & FORMAT ( ABS ( _biais ), "0.0", "fr-FR" ) & " point (" & _n & " prévisions comparées). L'erreur moyenne, dans un sens ou dans l'autre, est de "
			            & FORMAT ( _abs, "0.0", "fr-FR" ) & " point."
			    )
		displayFolder: 20 Pédagogie
		lineageTag: cd5fb73f-ffdc-468a-83f3-2bb43a762193

	/// Dette en fin d'année selon le scénario (observée pour « Observé »).
	measure 'Dette selon le scénario (% PIB)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), DIVIDE ( AVERAGE ( Fait_Projections[dette_pib] ), 100 ) )
		formatString: "0.0 %"
		displayFolder: 32 Scénarios
		lineageTag: 20949ea3-bdbd-47dd-83c2-c9eb588d6e10

	/// Solde public selon le scénario.
	measure 'Solde selon le scénario (% PIB)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), DIVIDE ( AVERAGE ( Fait_Projections[solde_pib] ), 100 ) )
		formatString: "0.0 %"
		displayFolder: 32 Scénarios
		lineageTag: f0ad203d-5d1f-49de-822b-3b9f26b2a85d

	/// Charge d'intérêts selon le scénario.
	measure 'Intérêts selon le scénario (% PIB)' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), DIVIDE ( AVERAGE ( Fait_Projections[interets_pib] ), 100 ) )
		formatString: "0.0 %"
		displayFolder: 32 Scénarios
		lineageTag: 521713c2-4330-4c5e-812e-129ef93d72ad

	/// Taux moyen payé sur la dette selon le scénario.
	measure 'Taux moyen payé selon le scénario' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), DIVIDE ( AVERAGE ( Fait_Projections[taux_apparent] ), 100 ) )
		formatString: "0.00 %"
		displayFolder: 32 Scénarios
		lineageTag: 02884acf-5ba0-48c8-9d35-b32cda090333

	/// Dernière année projetée.
	measure 'Année de fin du scénario' = IF ( HASONEVALUE ( Dim_Pays[Code pays] ), INT ( MAX ( Fait_Projections[date_id] ) / 10000 ) )
		formatString: "0"
		displayFolder: 32 Scénarios
		lineageTag: 198e355e-8c6a-4412-89f5-5f5d7d122706

	/// Dette la dernière année du scénario.
	measure 'Dette en fin de scénario (% PIB)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Projections[date_id] )
			    RETURN CALCULATE ( DIVIDE ( AVERAGE ( Fait_Projections[dette_pib] ), 100 ), Fait_Projections[date_id] = _d )
			)
		formatString: "0.0 %"
		displayFolder: 32 Scénarios
		lineageTag: 31605737-1c3e-4caa-a6d6-a9e6b2ff7300

	/// Charge d'intérêts la dernière année du scénario.
	measure 'Intérêts en fin de scénario (% PIB)' =
			IF (
			    HASONEVALUE ( Dim_Pays[Code pays] ),
			    VAR _d = MAX ( Fait_Projections[date_id] )
			    RETURN CALCULATE ( DIVIDE ( AVERAGE ( Fait_Projections[interets_pib] ), 100 ), Fait_Projections[date_id] = _d )
			)
		formatString: "0.0 %"
		displayFolder: 32 Scénarios
		lineageTag: cf0c5a69-24b3-4b3d-b3eb-d85c8c52435b

	/// Le scénario choisi comparé au scénario tendanciel, en une phrase.
	measure 'Phrase : scénarios' =
			VAR _candidats =
			    FILTER (
			        VALUES ( Dim_Scenario[Code scénario] ),
			        NOT ( Dim_Scenario[Code scénario] IN { "OBSERVE", "TENDANCIEL" } ) && NOT ISBLANK ( [Dette en fin de scénario (% PIB)] )
			    )
			VAR _code = CONCATENATEX ( TOPN ( 1, _candidats, CALCULATE ( MAX ( Dim_Scenario[ordre_tri] ) ), DESC ), Dim_Scenario[Code scénario] )
			VAR _libelle = CALCULATE ( FIRSTNONBLANK ( Dim_Scenario[Scénario], 1 ), REMOVEFILTERS ( Dim_Scenario ), Dim_Scenario[Code scénario] = _code )
			VAR _fin = CALCULATE ( [Année de fin du scénario], REMOVEFILTERS ( Dim_Scenario ), Dim_Scenario[Code scénario] = _code )
			VAR _dette = CALCULATE ( [Dette en fin de scénario (% PIB)], REMOVEFILTERS ( Dim_Scenario ), Dim_Scenario[Code scénario] = _code )
			VAR _tend = CALCULATE ( DIVIDE ( AVERAGE ( Fait_Projections[dette_pib] ), 100 ), REMOVEFILTERS ( Dim_Scenario ), Dim_Scenario[Code scénario] = "TENDANCIEL", REMOVEFILTERS ( Dim_Date ), Dim_Date[Année] = _fin )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( Dim_Pays[Code pays] ), "Choisissez un pays.",
			        _code = "", "Cochez un scénario (gouvernement ou personnel) pour le comparer à la situation actuelle prolongée.",
			        "En " & _fin & ", la dette atteindrait " & FORMAT ( _dette, "0 %", "fr-FR" ) & " de la richesse produite dans le scénario « "
			            & _libelle & " »"
			            & IF ( NOT ISBLANK ( _tend ),
			                ", contre " & FORMAT ( _tend, "0 %", "fr-FR" ) & " si la situation actuelle se prolonge (" & FORMAT ( ABS ( _dette - _tend ) * 100, "0", "fr-FR" )
			                    & " points " & IF ( _dette <= _tend, "de moins", "de plus" ) & ").",
			                "." )
			    )
		displayFolder: 20 Pédagogie
		lineageTag: 70a23ed9-ac4a-4430-8a40-8059ff2424ff

