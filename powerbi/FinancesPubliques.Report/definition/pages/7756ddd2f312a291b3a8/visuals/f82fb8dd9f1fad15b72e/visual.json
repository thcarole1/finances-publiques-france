          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Comprendre",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F4E79",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Les administrations publiques regroupent l'État et ses agences, les collectivités locales (communes, départements, régions) et la Sécurité sociale (retraites, assurance maladie, allocations familiales, assurance chômage).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#595959"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Une grande partie de la dépense publique ne « disparaît » pas : elle est reversée aux ménages sous forme de retraites, d'allocations ou de remboursements de soins.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#595959"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Les montants sont consolidés : un euro versé par l'État à une commune, puis dépensé par celle-ci, n'est compté qu'une fois.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#595959"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Source : Eurostat, comptes des administrations publiques. Les deux dernières années sont provisoires.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#595959"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
